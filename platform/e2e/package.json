{
  "name": "@raisin/e2e",
  "version": "0.1.0",
  "description": "Playwright end-to-end tests for the Raisin frontend platform",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "lint": "pnpm run -w g:eslint ./tests --cache"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@raisin/eslint-config": "workspace:*",
    "@raisin/tsconfig": "workspace:*",
    "@types/node": "^20.8.7"
  },
  "engines": {
    "node": "18.20.2",
    "pnpm": "8.15.8"
  }
}
