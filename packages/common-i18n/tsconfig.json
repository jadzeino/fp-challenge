{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@raisin/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "lib",
    "jsx": "react",
    "lib": ["dom", "ESNext"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib"]
}
