{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "removeComments": true
  }
}
