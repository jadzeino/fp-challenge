{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@raisin/tsconfig/library.json",
  "compilerOptions": {
    "outDir": "lib",
    "jsx": "react",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "**/__tests__/**"]
}
